rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default-deny catch-all)
    match /{document=**} {
      allow read, write: if false;
    }

    // Pastes Collection Rules
    match /pastes/{pasteId} {
      // Allow anyone to read a paste if they know its ID
      allow read: if true;
      
      // Allow creation only with strict payload validation
      allow create: if isValidId(pasteId) && isValidPaste(request.resource.data);
      
      // Strictly deny updates and deletions
      allow update, delete: if false;
    }

    // Helper: Validate Document ID
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Helper: Validate Paste Entity Schema, size, and timestamp integrity
    function isValidPaste(data) {
      return data.keys().hasAll(['code', 'language', 'createdAt'])
        && data.keys().size() == 3
        && data.code is string
        && data.code.size() <= 100000
        && data.language is string
        && data.language.size() <= 64
        && data.createdAt == request.time;
    }
  }
}
